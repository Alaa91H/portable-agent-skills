# Normalise text to LF in the repository and check out LF on every platform.
# Skill bodies embed shell commands, so CRLF would corrupt them on POSIX hosts.
* text=auto eol=lf

*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.zip binary